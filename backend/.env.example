# PitPulse AI backend configuration (all optional). Export these in your shell before starting uvicorn.

# Serve only the seeded demo dataset (no network). Useful for offline demos.
PITPULSE_OFFLINE=0

# Skip probing the official F1 live-timing archive (it requires an F1 account since 2026).
PITPULSE_DISABLE_FASTF1_LIVE=0

# Optional: F1 account credentials. When set, FastF1 can load full telemetry, sector times
# and tyre compounds. Without them, real races use historical timing (lap times, positions,
# pit stops) and telemetry is shown as unavailable.
# F1_USERNAME=
# F1_PASSWORD=

# Where FastF1 raw data and processed sessions are cached.
# PITPULSE_CACHE_DIR=./cache

# Allowed browser origins (comma separated).
PITPULSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
